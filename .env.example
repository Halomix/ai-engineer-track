# Copy this file to .env and fill in real values.
# .env is gitignored. This file (.env.example) is safe to commit â€”
# it documents WHICH settings exist without revealing any secrets.

# --- Local models (Ollama) â€” the default for this course ---
# Ollama runs models on your GPU and speaks the same language as the
# OpenAI API, so the same code works against both. No key needed;
# "ollama" is just a placeholder the library requires.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Which local model to use by default.
LOCAL_CHAT_MODEL=qwen3.5:4b
LOCAL_EMBED_MODEL=nomic-embed-text

# --- Cloud providers (optional; leave blank until you need them) ---
# You will not need these until Phase 5 at the earliest.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Local database (matches docker-compose.yml) ---
POSTGRES_USER=course
POSTGRES_PASSWORD=localdev
POSTGRES_DB=coursedb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# "+psycopg" tells SQLAlchemy which driver to use (psycopg3, the modern
# one — plain "postgresql://" defaults to the old psycopg2, which isn't
# installed here).
DATABASE_URL=postgresql+psycopg://course:localdev@localhost:5432/coursedb
